# ── Runtime ───────────────────────────────────────────────────────────────
FORECASTER_ENVIRONMENT=local
FORECASTER_LOG_LEVEL=INFO
FORECASTER_LOG_FORMAT=console          # console | json

# ── Storage ───────────────────────────────────────────────────────────────
# Local dev defaults to SQLite; no external services required.
# FORECASTER_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/forecaster
# FORECASTER_REDIS_URL=redis://localhost:6379/0

# ── Universe ──────────────────────────────────────────────────────────────
FORECASTER_HOT_TIER_MAX_SYMBOLS=800
FORECASTER_DEFAULT_HISTORY_YEARS=5

# ── Provider credentials (all optional) ───────────────────────────────────
# yfinance and Stooq need no key. The router skips anything unconfigured.
# FORECASTER_TIINGO_API_KEY=
# FORECASTER_ALPHAVANTAGE_API_KEY=
# FORECASTER_FINNHUB_API_KEY=
# FORECASTER_FMP_API_KEY=
# FORECASTER_FRED_API_KEY=
# FORECASTER_HUGGINGFACE_API_TOKEN=

# SEC requires a descriptive User-Agent with contact info on every request.
FORECASTER_SEC_USER_AGENT=StockForecaster research your@email.com

# ── API ───────────────────────────────────────────────────────────────────
FORECASTER_API_CORS_ORIGINS=http://localhost:3000,http://localhost:8501
